{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrans.invalid/schema/japanese-ocr-engine-candidate-input-v1.json",
  "title": "AITRANS Japanese OCR distributable engine shadow input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "datasetSha256", "run", "corpus", "contractExampleOnly", "cropSet", "engines", "results", "measurementRuns"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "benchmark": {"const": "japanese-ocr-engine-candidate"},
    "datasetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {"$ref": "#/$defs/run"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "contractExampleOnly": {"type": "boolean"},
    "cropSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/crop"}},
    "engines": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/engine"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "measurementRuns": {"type": "array", "items": {"$ref": "#/$defs/measurement"}}
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appSha", "evaluatorVersion", "invocationMode"],
      "properties": {
        "appSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evaluatorVersion": {"type": "string", "minLength": 1},
        "invocationMode": {"const": "cloud-only-shadow"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "sourceLicense", "datasetVerified", "pageCount", "humanRegionCount", "holdoutPageCount"],
      "properties": {
        "status": {"enum": ["contractExampleOnly", "authorized"]},
        "source": {"type": "string", "minLength": 1},
        "sourceLicense": {"type": "string", "minLength": 1},
        "datasetVerified": {"type": "boolean"},
        "pageCount": {"type": "integer", "minimum": 0},
        "humanRegionCount": {"type": "integer", "minimum": 0},
        "holdoutPageCount": {"type": "integer", "minimum": 0}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageID", "regionID", "cropLevel", "cropID", "cropSha256", "source", "referenceOnly"],
      "properties": {
        "pageID": {"type": "string", "minLength": 1},
        "regionID": {"type": "string", "minLength": 1},
        "cropLevel": {"enum": ["oracleCrop", "detectedCrop"]},
        "cropID": {"type": "string", "minLength": 1},
        "cropSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "expectedText": {"type": ["string", "null"]},
        "expectedTextNFC": {"type": ["string", "null"]},
        "referenceOnly": {"type": "boolean"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactID", "source", "sha256", "sizeBytes", "quantization", "license", "downloadPolicy"],
      "properties": {
        "artifactID": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 1},
        "quantization": {"type": ["string", "null"]},
        "license": {"type": "string", "minLength": 1},
        "downloadPolicy": {"enum": ["bundled", "cloudOnly", "userProvided", "notAvailable"]}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineID", "engineVersion", "candidateRole", "sourceRevision", "runtimeRevision", "model", "artifact", "license", "referenceOnly", "artifactStatus", "failureReason", "distribution", "defaultEnabled"],
      "properties": {
        "engineID": {"type": "string", "minLength": 1},
        "engineVersion": {"type": "string", "minLength": 1},
        "candidateRole": {"enum": ["baseline", "candidate"]},
        "sourceRevision": {"type": "string", "minLength": 1},
        "runtimeRevision": {"type": "string", "minLength": 1},
        "model": {"$ref": "#/$defs/model"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "license": {"type": "string", "minLength": 1},
        "referenceOnly": {"type": "boolean"},
        "artifactStatus": {"enum": ["available", "missing", "failed"]},
        "failureReason": {"type": ["string", "null"]},
        "distribution": {"enum": ["bundled", "userProvided", "cloudOnlyReference", "notDistributable"]},
        "defaultEnabled": {"type": "boolean"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision", "sha256", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineID", "pageID", "regionID", "cropLevel", "cropID", "status", "text", "confidence", "failureReason", "referenceOnly"],
      "properties": {
        "engineID": {"type": "string", "minLength": 1},
        "pageID": {"type": "string", "minLength": 1},
        "regionID": {"type": "string", "minLength": 1},
        "cropLevel": {"enum": ["oracleCrop", "detectedCrop"]},
        "cropID": {"type": "string", "minLength": 1},
        "status": {"enum": ["success", "empty", "failure"]},
        "text": {"type": "string"},
        "rawText": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "failureReason": {"type": ["string", "null"]},
        "referenceOnly": {"type": "boolean"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementID", "engineID", "deviceID", "deviceClass", "platform", "hardware", "os", "runtime", "status", "coldLatencyMs", "warmLatencyMs", "peakMemoryBytes", "energyMilliwattHours", "sampleCount", "measurementSource", "failureReason", "referenceOnly", "targetDevice"],
      "properties": {
        "measurementID": {"type": "string", "minLength": 1},
        "engineID": {"type": "string", "minLength": 1},
        "deviceID": {"type": "string", "minLength": 1},
        "deviceClass": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "hardware": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "partial", "failed", "missing"]},
        "coldLatencyMs": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "warmLatencyMs": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "peakMemoryBytes": {"type": ["integer", "null"], "minimum": 1},
        "energyMilliwattHours": {"type": ["number", "null"], "minimum": 0},
        "sampleCount": {"type": "integer", "minimum": 0},
        "measurementSource": {"type": "string", "minLength": 1},
        "failureReason": {"type": ["string", "null"]},
        "referenceOnly": {"type": "boolean"},
        "targetDevice": {"type": "boolean"}
      }
    }
  }
}
