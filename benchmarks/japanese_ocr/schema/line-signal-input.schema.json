{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrans.invalid/schema/japanese-ocr-line-signal-input-v1.json",
  "title": "AITRANS Japanese OCR native line/TextRegion shadow input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "datasetSha256", "run", "budgets", "pages", "candidates"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "benchmark": {"const": "japanese-ocr-line-signal"},
    "datasetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {"$ref": "#/$defs/run"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTextRegionCandidates", "maxLineCandidates", "maxTotalCandidates"],
      "properties": {
        "maxTextRegionCandidates": {"type": "integer", "minimum": 1},
        "maxLineCandidates": {"type": "integer", "minimum": 1},
        "maxTotalCandidates": {"type": "integer", "minimum": 1}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appSha", "engineID", "engineVersion", "model", "license", "device", "parameters"],
      "properties": {
        "appSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "engineID": {"type": "string", "minLength": 1},
        "engineVersion": {"type": "string", "minLength": 1},
        "model": {"$ref": "#/$defs/model"},
        "license": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageID", "textRegionStatus", "lineStatus", "failureReason"],
      "properties": {
        "pageID": {"type": "string", "minLength": 1},
        "textRegionStatus": {"enum": ["success", "empty", "failure"]},
        "lineStatus": {"enum": ["success", "empty", "failure"]},
        "failureReason": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateID", "pageID", "kind", "status", "bbox", "polygon", "confidence", "writingDirection", "readingOrder", "parentCandidateID", "source", "referenceOnly", "failureReason"],
      "properties": {
        "candidateID": {"type": "string", "minLength": 1},
        "pageID": {"type": "string", "minLength": 1},
        "kind": {"enum": ["textRegion", "line"]},
        "status": {"enum": ["success", "empty", "failure"]},
        "bbox": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "polygon": {"type": ["array", "null"], "items": {"type": "array", "minItems": 2, "maxItems": 2}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "writingDirection": {"enum": ["vertical", "horizontal", "mixed", "unknown", null]},
        "readingOrder": {"type": ["integer", "null"], "minimum": 0},
        "parentCandidateID": {"type": ["string", "null"]},
        "source": {"enum": ["nativeTextRegion", "nativeLine", "detectorRect", "visionCharacterProjection"]},
        "referenceOnly": {"type": "boolean"},
        "failureReason": {"type": ["string", "null"]}
      }
    }
  }
}
