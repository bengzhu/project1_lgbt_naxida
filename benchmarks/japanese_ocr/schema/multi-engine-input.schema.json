{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrans.invalid/schema/japanese-ocr-multi-engine-input-v1.json",
  "title": "AITRANS Japanese OCR multi-engine comparison input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "datasetSha256", "cropSet", "engines", "results"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "benchmark": {"const": "japanese-ocr-multi-engine"},
    "datasetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cropSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/crop"}},
    "engines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/engine"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision", "sha256", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineID", "engineVersion", "sourceRevision", "runtimeRevision", "model", "license", "referenceOnly", "artifactStatus", "failureReason"],
      "properties": {
        "engineID": {"type": "string", "minLength": 1},
        "engineVersion": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "string", "minLength": 1},
        "runtimeRevision": {"type": "string", "minLength": 1},
        "model": {"$ref": "#/$defs/model"},
        "license": {"type": "string", "minLength": 1},
        "referenceOnly": {"type": "boolean"},
        "artifactStatus": {"enum": ["available", "missing", "failed"]},
        "failureReason": {"type": ["string", "null"]}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageID", "regionID", "cropLevel", "cropID", "cropSha256", "source", "referenceOnly"],
      "properties": {
        "pageID": {"type": "string", "minLength": 1},
        "regionID": {"type": "string", "minLength": 1},
        "cropLevel": {"enum": ["oracleCrop", "detectedCrop"]},
        "cropID": {"type": "string", "minLength": 1},
        "cropSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "expectedText": {"type": ["string", "null"]},
        "expectedTextNFC": {"type": ["string", "null"]},
        "referenceOnly": {"type": "boolean"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineID", "pageID", "regionID", "cropLevel", "cropID", "status", "text", "confidence", "failureReason", "referenceOnly"],
      "properties": {
        "engineID": {"type": "string", "minLength": 1},
        "pageID": {"type": "string", "minLength": 1},
        "regionID": {"type": "string", "minLength": 1},
        "cropLevel": {"enum": ["oracleCrop", "detectedCrop"]},
        "cropID": {"type": "string", "minLength": 1},
        "status": {"enum": ["success", "empty", "failure"]},
        "text": {"type": "string"},
        "rawText": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "failureReason": {"type": ["string", "null"]},
        "referenceOnly": {"type": "boolean"}
      }
    }
  }
}
