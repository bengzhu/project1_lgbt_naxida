{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrans.local/benchmarks/japanese_ocr/fixture-manifest.schema.json",
  "title": "AITRANS Japanese OCR fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmark",
    "datasetVersion",
    "manifestSha256",
    "coordinateSpace",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "benchmark": { "const": "japanese-ocr" },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinateSpace": { "const": "normalizedTopLeft" },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "source", "license", "permittedUses"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "permittedUses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionID",
        "bbox",
        "polygon",
        "sourceText",
        "sourceTextNFC",
        "writingDirection",
        "readingOrder",
        "textType",
        "tags"
      ],
      "properties": {
        "regionID": { "type": "string", "minLength": 1 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "polygon": { "$ref": "#/$defs/polygon" },
        "linePolygons": {
          "type": "array",
          "items": { "$ref": "#/$defs/polygon" }
        },
        "sourceText": { "type": "string", "minLength": 1 },
        "sourceTextNFC": { "type": "string", "minLength": 1 },
        "writingDirection": { "enum": ["vertical", "horizontal", "mixed", "unknown"] },
        "readingOrder": { "type": "integer", "minimum": 0 },
        "textType": { "enum": ["dialogue", "narration", "SFX", "title", "other"] },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "bubbleID": { "type": ["string", "null"] }
      }
    },
    "oracleCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cropID", "pixelBBox", "expectedText", "expectedTextNFC", "referenceOnly"],
      "properties": {
        "cropID": { "type": "string", "minLength": 1 },
        "pixelBBox": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "expectedText": { "type": "string", "minLength": 1 },
        "expectedTextNFC": { "type": "string", "minLength": 1 },
        "referenceOnly": { "const": true }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageID",
        "split",
        "asset",
        "annotationStatus",
        "legacyRegression",
        "regions"
      ],
      "properties": {
        "pageID": { "type": "string", "minLength": 1 },
        "split": { "enum": ["train", "dev", "holdout"] },
        "asset": { "$ref": "#/$defs/asset" },
        "annotationStatus": {
          "enum": ["human", "contractExampleOnly", "legacyRegressionOnly", "pending"]
        },
        "legacyRegression": { "type": "boolean" },
        "exampleOnly": { "type": "boolean" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "oracleCrops": { "type": "array", "items": { "$ref": "#/$defs/oracleCrop" } }
      }
    }
  }
}
