{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrans.local/benchmarks/japanese_translation/model-profile-manifest.schema.json",
  "title": "AITRANS local GGUF model profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "contractExampleOnly", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "benchmark": { "const": "japanese-translation-model-profiles" },
    "contractExampleOnly": { "const": true },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileID", "modelFamily", "appSha", "model", "template", "capability", "decoding"],
      "properties": {
        "profileID": { "type": "string", "minLength": 1 },
        "modelFamily": { "enum": ["Gemma", "Qwen", "Sakura", "Llama", "Hunyuan", "experimental"] },
        "appSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "model": { "$ref": "#/$defs/model" },
        "template": { "$ref": "#/$defs/template" },
        "capability": { "$ref": "#/$defs/capability" },
        "decoding": { "$ref": "#/$defs/decoding" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "quantization", "license", "licenseReviewed"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "quantization": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseReviewed": { "type": "boolean" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "templateID", "templateSha256", "fallbackProfileID", "applyAPI"],
      "properties": {
        "source": { "enum": ["embedded", "explicitKnownFallback", "missingRejected", "unsupportedRejected"] },
        "templateID": { "type": ["string", "null"] },
        "templateSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "fallbackProfileID": { "type": ["string", "null"] },
        "applyAPI": { "const": "llama_chat_apply_template" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextLength", "maxBatchBlocks", "maxBatchCharacters", "sourceLanguages", "targetLanguages"],
      "properties": {
        "contextLength": { "type": "integer", "minimum": 1 },
        "maxBatchBlocks": { "const": 8 },
        "maxBatchCharacters": { "const": 1800 },
        "sourceLanguages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targetLanguages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileID", "mode", "seed", "temperature", "topK", "topP", "minP"],
      "properties": {
        "profileID": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["deterministic", "sampled"] },
        "seed": { "type": ["integer", "null"], "minimum": 0 },
        "temperature": { "type": "number", "minimum": 0 },
        "topK": { "type": ["integer", "null"], "minimum": 1 },
        "topP": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1 },
        "minP": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
